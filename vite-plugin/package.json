{
  "name": "@funcd-dev/vite-plugin",
  "version": "0.8.0",
  "type": "module",
  "description": "Vite plugin that bundles each funcd function into one self-contained ES module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pyvvo/funcd-typescript.git",
    "directory": "vite-plugin"
  },
  "homepage": "https://github.com/pyvvo/funcd-typescript/tree/main/vite-plugin#readme",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "build": "tsc -p tsconfig.lib.json"
  },
  "peerDependencies": {
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vite": "^8.3.2"
  }
}
