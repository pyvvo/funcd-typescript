{
  "name": "@funcd-dev/drizzle",
  "version": "0.19.2",
  "type": "module",
  "description": "Drizzle over funcd's context.sql: the sqlite-proxy database and drizzle-kit migrations applied in one execute",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pyvvo/funcd-typescript.git",
    "directory": "drizzle"
  },
  "homepage": "https://github.com/pyvvo/funcd-typescript/tree/main/drizzle#readme",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types --experimental-sqlite --no-warnings test/*.test.ts",
    "build": "tsc -p tsconfig.lib.json"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.45.0 <1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "drizzle-orm": "0.45.3",
    "typescript": "^5.7.0"
  }
}
