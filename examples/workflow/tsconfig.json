{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "types": ["node"],
    "lib": ["ES2022"],
    "paths": {
      "@pyvvo/funcd-shim": ["../../shim/src/types.ts"]
    }
  },
  "include": ["src", "test"]
}
